// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Add16(a=prevOut , b[0]=inc, b[1..15]=false , out=prevOutPlusInc);
    Mux16(a=prevOutPlusInc , b=in , sel=load , out=o2);
    Mux16(a=o2 , b=false , sel=reset , out=o3);
    Register(in=o3 , load=true , out=out, out=prevOut);
}